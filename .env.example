# RepoLens Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control!

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (VITE_*)
# =============================================================================
# API URL - Backend server endpoint
VITE_API_URL=http://localhost:8000

# GitHub repository for bug reporting (username/repo)
VITE_GITHUB_REPO=your-org/repolens

# Sentry Error Tracking (Optional)
# Get DSN from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=

# PostHog Analytics (Optional)
# Sign up at: https://posthog.com/
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Web Vitals Performance Tracking (Optional)
# Set to 'true' to enable in development
VITE_ENABLE_WEB_VITALS=false

# Application URL (for SEO/Open Graph)
VITE_APP_URL=https://repolens.app

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
APP_ENV=development  # development | production | staging
DEBUG=true  # Set to false in production
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Frontend URL (for OAuth redirects)
# CRITICAL: Must match your actual frontend URL in production
FRONTEND_URL=http://localhost:8080
# For production:
# FRONTEND_URL=https://your-domain.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# --- Local Development (Docker) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test

# --- Production: Neo4j Aura Free ---
# Sign up at: https://console.neo4j.io (free tier: 200K nodes, 400K relationships)
# IMPORTANT: Use neo4j+s:// (encrypted) NOT bolt://
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# --- Local Development (Docker) ---
REDIS_URL=redis://localhost:6379/0

# --- Production: Upstash Redis Free ---
# Sign up at: https://console.upstash.com (free tier: 256MB, 500K commands/mo)
# IMPORTANT: Use rediss:// (TLS) NOT redis://
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================
# Create an OAuth app at: https://github.com/settings/developers
# Development URLs:
#   Homepage URL: http://localhost:8080
#   Authorization callback URL: http://localhost:8000/api/auth/github/callback
# Production URLs:
#   Homepage URL: https://your-domain.com
#   Authorization callback URL: https://api.your-domain.com/api/auth/github/callback

GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a secure key with:
#   openssl rand -hex 32
#   OR: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Select your LLM provider: "openrouter" (recommended) or "deepseek"
LLM_PROVIDER=openrouter

# -----------------------------------------------------------------------------
# OPENROUTER (RECOMMENDED - FREE with MiMo V2 Flash)
# -----------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (see https://openrouter.ai/models)
# Recommended free models:
#   - xiaomi/mimo-v2-flash (262K context, #1 open-source model)
#   - google/gemini-2.0-flash-exp:free
# Paid models:
#   - deepseek/deepseek-chat ($0.14/M tokens)
#   - qwen/qwq-32b ($0.15/M tokens)
OPENROUTER_MODEL=xiaomi/mimo-v2-flash

# Attribution headers (for OpenRouter leaderboards)
OPENROUTER_SITE_URL=https://repolens.app
OPENROUTER_SITE_NAME=RepoLens

# -----------------------------------------------------------------------------
# DEEPSEEK (LEGACY)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.deepseek.com/api_keys
# Only needed if LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat  # or deepseek-coder for code-specific tasks

# -----------------------------------------------------------------------------
# LLM Request Settings
# -----------------------------------------------------------------------------
MAX_TOKENS_PER_REQUEST=4000
LLM_TEMPERATURE=0.1  # Lower for more deterministic code explanations
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30  # seconds

# Cache Settings
ENABLE_LLM_CACHE=true  # Cache LLM responses to save costs
LLM_CACHE_TTL=86400  # 24 hours in seconds

# =============================================================================
# REPOSITORY PARSING LIMITS
# =============================================================================
# Maximum directory depth to traverse (prevents deep recursion in large repos)
REPOLENS_MAX_DEPTH=10

# Maximum files to parse (prioritizes src/ files when limit is exceeded)
REPOLENS_MAX_FILES=1000

# =============================================================================
# RATE LIMITING & COST CONTROL
# =============================================================================
# Rate Limits (requests per minute)
RATE_LIMIT_GLOBAL=30
RATE_LIMIT_PER_USER=15

# Cost Limits (USD)
DAILY_COST_LIMIT=10.00
MONTHLY_COST_LIMIT=100.00
PER_USER_DAILY_LIMIT=2.00

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=10000  # Number of embeddings to cache

# =============================================================================
# DEMO MODE CONFIGURATION
# =============================================================================
ENABLE_DEMO_MODE=true  # Allow users to explore without GitHub
DEMO_AUTO_LOAD=true  # Load demo data on startup
MAX_DEMO_REPOS=5  # Maximum number of demo repositories

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
RQ_WORKER_COUNT=2  # Number of background workers
RQ_JOB_TIMEOUT=3600  # Job timeout in seconds (1 hour)
ENABLE_EMBEDDINGS_ON_PARSE=true  # Generate embeddings during parsing
ENABLE_SUMMARIES_ON_PARSE=false  # Generate AI summaries during parsing (costs money!)

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# For production (Netlify), set to your frontend domain:
# CORS_ORIGINS=https://your-app.netlify.app

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Secret key for sessions
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# HTTPS Settings (production only)
FORCE_HTTPS=false  # Set to true in production
SECURE_COOKIES=false  # Set to true in production

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# SSL Certificate Verification (IMPORTANT: Keep true for production!)
# Only set to false for local development with SSL issues
SSL_VERIFY=true

# Custom CA Bundle Path (optional, for corporate environments)
# Uncomment and set path if you need to use a custom CA certificate bundle
# SSL_CA_BUNDLE=/path/to/corporate-ca-bundle.crt

# TLS Minimum Version (1.2 or 1.3 recommended)
# Values: 1.2 (default), 1.3 (more secure but may have compatibility issues)
TLS_MIN_VERSION=1.2

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log to file
LOG_TO_FILE=false
LOG_FILE_PATH=logs/repolens.log

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# API Server
UVICORN_WORKERS=1  # Keep at 1 for free tier (limited RAM)
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Database Connection Pool (reduce for free tier)
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=10  # Reduced for Aura Free
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60

# Redis Connection Pool (reduce for free tier)
REDIS_MAX_CONNECTIONS=10  # Reduced for Upstash Free

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_API_DOCS=false  # SECURITY: Keep disabled in production to hide API structure
ENABLE_HEALTH_CHECK=true
ENABLE_METRICS=false  # Prometheus metrics (coming soon)

# =============================================================================
# DEPLOYMENT PLATFORM SETTINGS
# =============================================================================
# Render/Railway will set PORT automatically
# PORT=8000  # Uncomment only for local testing

# Hugging Face cache directory (for embeddings model)
HF_HOME=/tmp/huggingface
TORCH_HOME=/tmp/torch
